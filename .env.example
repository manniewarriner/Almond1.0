# Copy to .env and fill in real values. Never commit a real .env file.
# All values below are placeholders only.

FIRM_AI_DATA_DIR=data
FIRM_AI_AUDIT_DB_PATH=data/audit.db

# One of: fake, local, approved
FIRM_AI_PROVIDER_NAME=fake

# Required only when FIRM_AI_PROVIDER_NAME=approved
FIRM_AI_PROVIDER_API_KEY=
FIRM_AI_PROVIDER_BASE_URL=

# General Chat uses Almond's bundled llama.cpp server on 127.0.0.1 only.
FIRM_AI_LOCAL_CHAT_MODEL=Qwen3.5-2B-Q4_K_M.gguf
