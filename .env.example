# Copy to .env and fill in real values. Never commit a real .env file.
# All values below are placeholders only.

FIRM_AI_DATA_DIR=data
FIRM_AI_AUDIT_DB_PATH=data/audit.db

# One of: fake, local, approved
FIRM_AI_PROVIDER_NAME=fake

# Required only when FIRM_AI_PROVIDER_NAME=approved
FIRM_AI_PROVIDER_API_KEY=
FIRM_AI_PROVIDER_BASE_URL=

# General Chat uses Almond's bundled llama.cpp server on 127.0.0.1 only.
FIRM_AI_LOCAL_CHAT_MODEL=MiniCPM5-2B-Q4_K_M.gguf
# Developer TUI (safe local defaults)
ALMOND_DEV_MODEL__PROVIDER=llama_cpp
ALMOND_DEV_MODEL__MODEL=MiniCPM5-2B-Q4_K_M.gguf
ALMOND_DEV_MODEL__BASE_URL=http://127.0.0.1:11435
# Document bot's AI formatting runs a second local model, on its own
# server (127.0.0.1:11436) -- Qwen3.5-2B follows the strict
# block-classification schema more reliably than the chat model above.
ALMOND_DEV_MODEL__DOCUMENT_MODEL=Qwen3.5-2B-Q4_K_M.gguf
ALMOND_DEV_RAG_TOP_K=5
ALMOND_DEV_LOG_LEVEL=INFO
ALMOND_DEV_STREAMING=true

# Developer-only local control bridge for `almond ctl ...` (see
# docs/CONTROL_BRIDGE.md). Disabled by default; never enable this on a
# normal staff machine. Loopback-only (127.0.0.1), token-authenticated.
ALMOND_DEV_CONTROL_ENABLED=false
